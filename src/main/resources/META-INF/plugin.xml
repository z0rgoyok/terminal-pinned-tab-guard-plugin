<idea-plugin>
    <id>ru.fixprice.tools.terminalPinnedTabGuard</id>
    <name>Terminal Pinned Tab Guard</name>
    <vendor>FixPrice</vendor>

    <description><![CDATA[
    Запрещает закрытие закреплённой вкладки Terminal (после «Move to Editor») по Cmd+W.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity
            implementation="ru.fixprice.tools.terminal_pinned_tab_guard.TerminalPinnedTabCloseGuardStartupActivity" />
    </extensions>

    <actions>
        <action id="TerminalPinnedTabGuard.OpenTerminalInEditor"
                class="ru.fixprice.tools.terminal_pinned_tab_guard.action.OpenTerminalInEditorAction"
                text="Open Terminal in Editor"
                description="Open Terminal tab directly in the editor"
                icon="AllIcons.Nodes.Console">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
        <group id="TerminalPinnedTabGuard.SelectTerminalInEditorGroup"
               text="Select Terminal in Editor"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last" />
            <action id="TerminalPinnedTabGuard.SelectTerminal1"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 1">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 1" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 1" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 1" />
            </action>
            <action id="TerminalPinnedTabGuard.SelectTerminal2"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 2">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 2" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 2" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 2" />
            </action>
            <action id="TerminalPinnedTabGuard.SelectTerminal3"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 3">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 3" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 3" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 3" />
            </action>
            <action id="TerminalPinnedTabGuard.SelectTerminal4"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 4">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 4" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 4" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 4" />
            </action>
            <action id="TerminalPinnedTabGuard.SelectTerminal5"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 5">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 5" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 5" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 5" />
            </action>
            <action id="TerminalPinnedTabGuard.SelectTerminal6"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 6">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 6" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 6" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 6" />
            </action>
            <action id="TerminalPinnedTabGuard.SelectTerminal7"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 7">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 7" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 7" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 7" />
            </action>
            <action id="TerminalPinnedTabGuard.SelectTerminal8"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 8">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 8" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 8" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 8" />
            </action>
            <action id="TerminalPinnedTabGuard.SelectTerminal9"
                    class="ru.fixprice.tools.terminal_pinned_tab_guard.action.SelectTerminalInEditorAction"
                    text="Terminal 9">
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt 9" />
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt 9" />
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt 9" />
            </action>
        </group>
    </actions>
</idea-plugin>
